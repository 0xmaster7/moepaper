{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnBucketReadWrite",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::moe-paper-aman-2026", "arn:aws:s3:::moe-paper-aman-2026/*"]
    },
    {
      "Sid": "SorelPublicRead",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::sorel-20m", "arn:aws:s3:::sorel-20m/*"]
    }
  ]
}
